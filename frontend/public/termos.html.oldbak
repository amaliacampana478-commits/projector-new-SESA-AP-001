<style id="__mobile_header_fix">
@media (max-width: 768px) {
  html, body { overflow-x: hidden !important; max-width: 100vw !important; }
  /* Empty #TopoMobile — always hidden */
  #TopoMobile { display: none !important; }
  /* Compact mobile header: only logo + blue background */
  #Topo, body #Topo, div#Topo {
    display: block !important;
    width: 100% !important;
    max-width: 100vw !important;
    height: auto !important;
    min-height: 0 !important;
    padding: 10px 0 !important;
    margin: 0 0 8px 0 !important;
    box-sizing: border-box !important;
  }
  #Topo .Conteudo { width: 100% !important; max-width: 100% !important; padding: 0 !important; margin: 0 !important; box-sizing: border-box !important; }
  #Topo #Logo, #Logo {
    float: none !important;
    width: 100% !important;
    min-height: 0 !important;
    height: auto !important;
    margin: 0 !important;
    padding: 0 !important;
    text-align: center !important;
    display: block !important;
  }
  #Topo #Logo h1, #Logo h1 { width: 100% !important; margin: 0 !important; padding: 0 !important; text-align: center !important; }
  #Topo #Logo h1 a, #Logo h1 a { display: inline-block !important; margin: 0 auto !important; }
  #Topo #Logo img, #Logo h1 img, #Logo img {
    display: inline-block !important;
    max-height: 52px !important;
    max-width: 88vw !important;
    width: auto !important;
    height: auto !important;
    margin: 0 auto !important;
  }
  /* Remove menu bar and "Área do Candidato" on mobile */
  #TopMenu { display: none !important; }
  #Topo #TopLogin, #TopLogin { display: none !important; }
  #Topo #DadosEmpresa, #Topo #site_email, #DadosEmpresa, #site_email { display: none !important; }
  /* Hide accessibility VLibras widget on mobile */
  div[vw], div[vw].enabled, div[vw-access-button], div[vw-plugin-wrapper], div[vw-plugin-top-wrapper], [class*="vlibras"], [class*="vpw-"], [class*="vw-"] { display: none !important; visibility: hidden !important; }
}
</style>
</head>
<body>
<style id="__pl_style">
#__page_loader{position:fixed;inset:0;background:rgba(255,255,255,.92);z-index:2147483646;display:flex;align-items:center;justify-content:center;transition:opacity .25s;opacity:1}
#__page_loader.__hidden{opacity:0;pointer-events:none}
#__page_loader .__spinner{width:52px;height:52px;border:4px solid #e4e9ef;border-top-color:#1858BF;border-radius:50%;animation:__pl_spin .8s linear infinite}
@keyframes __pl_spin{to{transform:rotate(360deg)}}
</style>
<div id="__page_loader" aria-hidden="true"><div class="__spinner"></div></div>
<script id="__pl_js">
(function(){
  var loader=document.getElementById('__page_loader');
  function show(){ if(loader) loader.classList.remove('__hidden'); }
  function hide(){ if(loader) loader.classList.add('__hidden'); }
  var t0=Date.now();
  function scheduleHide(){ var wait=Math.max(0,700-(Date.now()-t0)); setTimeout(hide,wait); }
  if(document.readyState==='complete') scheduleHide();
  else window.addEventListener('load',scheduleHide);
  document.addEventListener('click',function(e){
    var a=e.target&&e.target.closest&&e.target.closest('a[href]');
    if(!a) return;
    var href=a.getAttribute('href')||'';
    if(!href||href.charAt(0)==='#'||/^javascript:/i.test(href)||a.target==='_blank') return;
    try{ var u=new URL(href,window.location.href); if(u.origin!==window.location.origin) return; }catch(err){ return; }
    show();
  },true);
  document.addEventListener('submit',show,true);
  window.addEventListener('beforeunload',show);
})();
</script>

 
 
 
 
 
 
 
 
